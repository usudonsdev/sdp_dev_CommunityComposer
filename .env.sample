# =============================================================================
# Google OAuth 設定（ログインテスト前に必須）
# =============================================================================
#
# 【取得手順】Google Cloud Console (https://console.cloud.google.com/)
# 1. プロジェクトを作成（または既存を選択）
# 2. 「APIとサービス」→「OAuth 同意画面」
#    - ユーザータイプ: 内部（Workspace）または外部
#    - スコープ: openid, email, profile
# 3. 「APIとサービス」→「認証情報」→「認証情報を作成」→「OAuth クライアント ID」
#    - アプリケーションの種類: ウェブアプリケーション
#    - 承認済みの JavaScript 生成元（ローカル開発時）:
#        http://localhost:8080
#    - 承認済みのリダイレクト URI（ローカル Docker 開発時）:
#        http://localhost:8080/auth/google/callback
#        http://localhost:8080/admin/auth/google/callback
#    - VM / 本番（HTTPS）の例:
#        https://your-team.example.com/auth/google/callback
#        https://your-team.example.com/admin/auth/google/callback
# 4. 作成後に表示される「クライアント ID」「クライアント シークレット」を下記へ貼り付け
#
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 芝浦工大 Google Workspace ドメイン（通常は変更不要）
GOOGLE_HOSTED_DOMAIN=shibaura-it.ac.jp

# Flask セッション暗号化キー（本番では openssl rand -hex 32 等で生成）
SECRET_KEY=dev-secret-key-change-me-in-production

# 管理者ログイン用シークレット（UI→API の管理者認証。本番ではランダム文字列に変更）
AUTH_ADMIN_SECRET=admin-secret-change-me

# -----------------------------------------------------------------------------
# 認証モード
# -----------------------------------------------------------------------------
# AUTH_MOCK_ENABLED を省略すると:
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET が有効 → Google OAuth
#   未設定またはプレースホルダ → モック（メール入力）認証
# 明示的に切り替える場合:
# AUTH_MOCK_ENABLED=0   # Google OAuth を強制
# AUTH_MOCK_ENABLED=1   # モック認証を強制
#
# AUTH_MOCK_ENABLED=0

# -----------------------------------------------------------------------------
# ローカル開発（localhost）
# -----------------------------------------------------------------------------
# 推奨: scripts/dev-up.ps1  または  docker compose -f compose.yaml -f compose.local.yaml up -d
# OAuth リダイレクト: http://localhost:8080/auth/google/callback
#
# .env では PUBLIC_BASE_URL を空にして compose.local.yaml に任せてもよい。
PUBLIC_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# VM デプロイ（GitHub Secrets で上書き）
# -----------------------------------------------------------------------------
# VM では PUBLIC_BASE_URL に Tunnel 等の HTTPS URL を設定（末尾 / なし、/login は付けない）
# 例: PUBLIC_BASE_URL=https://your-team.example.com
# vm-deploy.sh が GOOGLE_OAUTH_REDIRECT_URI を自動生成する
#
# ローカルの .env とは別管理。GitHub Secrets の PUBLIC_BASE_URL が VM 用。

# PUBLIC_BASE_URL=https://your-team.example.com

FLASK_ENV=development
FLASK_DEBUG=1

# =============================================================================
# 本番 VM デプロイ用 GitHub Secrets（Settings → Secrets and variables → Actions）
# =============================================================================
# 以下の Secret 名で .env と同じ値を登録すると、vm-deploy.yml 経由で VM に渡されます。
#
#   SECRET_KEY              … Flask セッション鍵
#   GOOGLE_CLIENT_ID        … OAuth クライアント ID
#   GOOGLE_CLIENT_SECRET    … OAuth クライアント Secret
#   GOOGLE_HOSTED_DOMAIN    … 例: shibaura-it.ac.jp
#   AUTH_ADMIN_SECRET       … 管理者ログイン用
#   AUTH_MOCK_ENABLED       … 0（Google OAuth）または 1（モック）
#   PUBLIC_BASE_URL         … VM 用 HTTPS サイト URL（末尾 / なし、/login は付けない）
#   FLASK_ENV               … 例: development または production
#   FLASK_DEBUG             … 本番では 0 推奨
#
# VM では PUBLIC_BASE_URL から OAuth リダイレクト URI が自動生成されます。
# ローカルでは compose.local.yaml または PUBLIC_BASE_URL=http://localhost:8080 を使用。
#
# Google Console には **両方** のリダイレクト URI を登録可能:
#   http://localhost:8080/auth/google/callback
#   https://your-vm-url.example.com/auth/google/callback
#
# .env ファイル自体は Git にコミットしないこと。
