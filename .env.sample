### 更新: .env.example

# Googleログイン用のクライアントID
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Flaskのセッション暗号化キー（本番環境では強固なランダム文字列にしてください）
SECRET_KEY=dev-secret-key-change-me-in-production

# VM 本番: Google OAuth 用の公開 HTTPS URL（末尾スラッシュなし）
# 例: https://your-team.example.com または Cloudflare Tunnel の URL
PUBLIC_BASE_URL=

FLASK_ENV=development
FLASK_DEBUG=1